<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RogueTrader.Overwatch</AssemblyName>
    <RootNamespace>RogueTraderOverwatch</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Steam\steamapps\common\Warhammer 40,000 Rogue Trader</GameDir>
    <Managed>$(GameDir)\WH40KRT_Data\Managed</Managed>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(USERPROFILE)\AppData\LocalLow\Owlcat Games\Warhammer 40000 Rogue Trader</GameDataDir>
    <ModDir>$(GameDataDir)\Modifications\RogueTrader.Overwatch</ModDir>
    <ModSource>$(MSBuildThisFileDirectory)..\..\mod</ModSource>
  </PropertyGroup>

  <!-- Every game assembly except the framework ones, which net48 already provides. -->
  <ItemGroup>
    <GameAssembly Include="$(Managed)\*.dll" Exclude="$(Managed)\mscorlib.dll;$(Managed)\netstandard.dll;$(Managed)\System*.dll;$(Managed)\Mono.*.dll;$(Managed)\Microsoft.*.dll" />
    <Reference Include="@(GameAssembly)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ModFile Include="$(ModSource)\**\*" />
    <!-- Only the in-game icons (the names Icons.cs maps); Header.png and Logo.png are for the Nexus page. -->
    <IconName Include="ReflexShot;Overwatch;OverwatchShots;Suppression;Suppressed" />
    <IconFile Include="@(IconName->'$(MSBuildThisFileDirectory)..\..\assets\%(Identity).png')" />
  </ItemGroup>

  <!-- The mod folder the game loads: mod\ as-is, this assembly under Assemblies\ and the icons under Icons\. -->
  <Target Name="InstallMod" AfterTargets="Build">
    <RemoveDir Directories="$(ModDir)" />
    <Copy SourceFiles="@(ModFile)" DestinationFiles="@(ModFile->'$(ModDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)\Assemblies" />
    <Copy SourceFiles="@(IconFile)" DestinationFolder="$(ModDir)\Icons" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Enable-Mod.ps1&quot; -GameDataDir &quot;$(GameDataDir)&quot; -Name RogueTrader.Overwatch" />
    <Message Importance="high" Text="Installed to $(ModDir)" />
  </Target>

  <!-- dotnet build -c Release also writes the Nexus upload: dist\RogueTrader.Overwatch-<version>.zip holding the
       RogueTrader.Overwatch folder that goes into the game's Modifications folder. -->
  <Target Name="PackageMod" AfterTargets="InstallMod" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ModSource)\OwlcatModificationManifest.json')), '"Version":\s*"([^"]+)"').Groups[1].Value)</ModVersion>
      <DistDir>$(MSBuildThisFileDirectory)..\..\dist</DistDir>
      <StageDir>$(IntermediateOutputPath)package</StageDir>
    </PropertyGroup>
    <ItemGroup>
      <InstalledFile Include="$(ModDir)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="@(InstalledFile)" DestinationFiles="@(InstalledFile->'$(StageDir)\RogueTrader.Overwatch\%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(DistDir)\RogueTrader.Overwatch-$(ModVersion).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(DistDir)\RogueTrader.Overwatch-$(ModVersion).zip" />
  </Target>

</Project>
